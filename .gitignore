### C ###
# Prerequisites
*.d

# Object files
*.o
*.ko
*.obj
*.elf

# Linker output
*.ilk
*.map
*.exp

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
*.su
*.idb
*.pdb

# Kernel Module Compile Results
*.mod*
*.cmd
.tmp_versions/
modules.order
Module.symvers
Mkfile.old
dkms.conf

# End of https://www.toptal.com/developers/gitignore/api/c

# =========================================================================
# STM32 & STM32CubeIDE / Eclipse Embedded C additions
# =========================================================================

# Ignore IDE build output directories
Debug/
Release/
build/

# Additional embedded firmware formats
*.bin
*.axf

# Local IDE settings (often contain absolute local paths)
.settings/
.launches/
.metadata/

# Debugger logs and history
*.log
openocd.log
.gdb_history

# Temporary files generated by STM32CubeMX (if code generator is used)
*.backup
